{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/o005-original-authority-manifest.schema.json",
  "title": "O005 original bridge authority manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "unit_id", "record", "canonical_content", "notebook",
    "mastery", "lock", "generator", "segment_id_ledger", "toolchain"
  ],
  "properties": {
    "schema": {"const": "o005-original-authority-manifest-v1"},
    "unit_id": {"type": "string", "pattern": "^O005-BRIDGE-C[1234]$"},
    "record": {"$ref": "#/$defs/fileIdentity"},
    "canonical_content": {"$ref": "#/$defs/fileIdentity"},
    "notebook": {"$ref": "#/$defs/fileIdentity"},
    "mastery": {"$ref": "#/$defs/fileIdentity"},
    "lock": {"$ref": "#/$defs/fileIdentity"},
    "generator": {"$ref": "#/$defs/fileIdentity"},
    "segment_id_ledger": {"$ref": "#/$defs/fileIdentity"},
    "toolchain": {"$ref": "#/$defs/toolchain"}
  },
  "allOf": [
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C1"}}},
      "then": {
        "properties": {
          "record": {"properties": {"path": {"const": "authority/units/O005-BRIDGE-C1/source-record.canonical.json"}}},
          "canonical_content": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C1/content.html"}}},
          "notebook": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C1/notebooks/bridge-c1-reproducible-workflow.ipynb"}}},
          "mastery": {"properties": {"path": {"const": "backend/mastery/O005-BRIDGE-C1.mastery.json"}}},
          "lock": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C1/notebooks/requirements.lock"}}},
          "generator": {"properties": {"path": {"const": "scripts/generate_bridge_c1.py"}}},
          "segment_id_ledger": {
            "properties": {
              "path": {"pattern": "^backend/segment-ids/O005-BRIDGE-C1\\.segment-ids\\.v[1-9][0-9]*\\.json$"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C2"}}},
      "then": {
        "properties": {
          "record": {"properties": {"path": {"const": "authority/units/O005-BRIDGE-C2/source-record.canonical.json"}}},
          "canonical_content": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C2/content.html"}}},
          "notebook": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C2/notebooks/bridge-c2-local-bifurcations.ipynb"}}},
          "mastery": {"properties": {"path": {"const": "backend/mastery/O005-BRIDGE-C2.mastery.json"}}},
          "lock": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C2/notebooks/requirements.lock"}}},
          "generator": {"properties": {"path": {"const": "scripts/generate_bridge_c2.py"}}},
          "segment_id_ledger": {
            "properties": {
              "path": {"pattern": "^backend/segment-ids/O005-BRIDGE-C2\\.segment-ids\\.v[1-9][0-9]*\\.json$"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C3"}}},
      "then": {
        "properties": {
          "record": {"properties": {"path": {"const": "authority/units/O005-BRIDGE-C3/source-record.canonical.json"}}},
          "canonical_content": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C3/content.html"}}},
          "notebook": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C3/notebooks/bridge-c3-chaos-and-return-maps.ipynb"}}},
          "mastery": {"properties": {"path": {"const": "backend/mastery/O005-BRIDGE-C3.mastery.json"}}},
          "lock": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C3/notebooks/requirements.lock"}}},
          "generator": {"properties": {"path": {"const": "scripts/generate_bridge_c3.py"}}},
          "segment_id_ledger": {
            "properties": {
              "path": {"pattern": "^backend/segment-ids/O005-BRIDGE-C3\\.segment-ids\\.v[1-9][0-9]*\\.json$"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C4"}}},
      "then": {
        "properties": {
          "record": {"properties": {"path": {"const": "authority/units/O005-BRIDGE-C4/source-record.canonical.json"}}},
          "canonical_content": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C4/content.html"}}},
          "notebook": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C4/notebooks/bridge-c4-calibration-validation-uncertainty.ipynb"}}},
          "mastery": {"properties": {"path": {"const": "backend/mastery/O005-BRIDGE-C4.mastery.json"}}},
          "lock": {"properties": {"path": {"const": "source/id-ID/O005-BRIDGE-C4/notebooks/requirements.lock"}}},
          "generator": {"properties": {"path": {"const": "scripts/generate_bridge_c4.py"}}},
          "segment_id_ledger": {
            "properties": {
              "path": {"pattern": "^backend/segment-ids/O005-BRIDGE-C4\\.segment-ids\\.v[1-9][0-9]*\\.json$"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "pandoc", "python", "platform", "dependencies"],
      "properties": {
        "files": {
          "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
          "items": {"$ref": "#/$defs/fileIdentity"}
        },
        "pandoc": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "bytes", "sha256"],
          "properties": {
            "version": {"type": "string", "pattern": "^pandoc [0-9]+(?:\\.[0-9]+)+$"},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "python": {
          "type": "object", "additionalProperties": false,
          "required": ["implementation", "version", "executable_bytes", "executable_sha256"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "executable_bytes": {"type": "integer", "minimum": 1},
            "executable_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "platform": {
          "type": "object", "additionalProperties": false,
          "required": ["system", "release", "version", "machine"],
          "properties": {
            "system": {"type": "string", "minLength": 1},
            "release": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "machine": {"type": "string", "minLength": 1}
          }
        },
        "dependencies": {
          "type": "object", "additionalProperties": false,
          "required": ["beautifulsoup4", "jsonschema"],
          "properties": {
            "beautifulsoup4": {"type": "string", "minLength": 1},
            "jsonschema": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
