{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/o005-bridge-unit.schema.json",
  "title": "O005 original bridge unit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "unit_id", "course_id", "resource_id", "language",
    "content_mode", "provenance", "target", "segments", "problems",
    "mastery_path", "mastery_sha256", "notebook_path", "notebook_sha256", "build"
  ],
  "properties": {
    "schema": {"const": "o005-bridge-unit-v1"},
    "unit_id": {"type": "string", "pattern": "^O005-BRIDGE-C[1234]$"},
    "course_id": {"const": "C120"},
    "resource_id": {"const": "O005"},
    "language": {"const": "id-ID"},
    "content_mode": {"const": "new_original_addition"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_identification", "license", "spine_author", "spine_work",
        "relationship", "non_endorsement", "authority_manifest", "authority_manifest_sha256"
      ],
      "properties": {
        "model_identification": {"const": "OpenAI Codex gpt-5.6-sol, Ultra."},
        "license": {"const": "CC BY-NC-SA 4.0"},
        "spine_author": {"const": "Joceline Lega"},
        "spine_work": {"const": "Introduction to Mathematical Modeling"},
        "relationship": {"const": "independent_supplement"},
        "non_endorsement": {"const": true},
        "authority_manifest": {
          "type": "string",
          "pattern": "^authority/units/O005-BRIDGE-C[1234]/AUTHORITY_MANIFEST\\.json$"
        },
        "authority_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "content_path", "content_sha256", "concepts", "placement"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "content_path": {
          "type": "string",
          "pattern": "^source/id-ID/O005-BRIDGE-C[1234]/content\\.html$"
        },
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "placement": {"type": "string", "minLength": 1}
      }
    },
    "segments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count", "path", "sha256", "schema", "id_strategy", "id_ledger_path", "id_ledger_sha256"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "path": {
          "type": "string",
          "pattern": "^backend/segments/O005-BRIDGE-C[1234]\\.segments\\.jsonl$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"const": "o005-bridge-segment-v1"},
        "id_strategy": {
          "enum": [
            "versioned-semantic-ledger-v1",
            "html-anchored-versioned-semantic-ledger-v1"
          ]
        },
        "id_ledger_path": {
          "type": "string",
          "pattern": "^backend/segment-ids/O005-BRIDGE-C[1234]\\.segment-ids\\.v[1-9][0-9]*\\.json$"
        },
        "id_ledger_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "problems": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^O005-BRIDGE-C[1234]-P0[1-7]$"}
    },
    "mastery_path": {
      "type": "string",
      "pattern": "^backend/mastery/O005-BRIDGE-C[1234]\\.mastery\\.json$"
    },
    "mastery_sha256": {"$ref": "#/$defs/sha256"},
    "notebook_path": {
      "type": "string",
      "pattern": "^source/id-ID/O005-BRIDGE-C[1234]/notebooks/[a-z0-9-]+\\.ipynb$"
    },
    "notebook_sha256": {"$ref": "#/$defs/sha256"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script", "generator", "pandoc", "requirements_lock", "requirements_lock_sha256", "toolchain"
      ],
      "properties": {
        "script": {"const": "scripts/build_bridge_unit.py"},
        "generator": {"type": "string", "pattern": "^scripts/generate_bridge_c[1234]\\.py$"},
        "pandoc": {"type": "string", "pattern": "^pandoc [0-9]+(?:\\.[0-9]+)+$"},
        "requirements_lock": {
          "type": "string",
          "pattern": "^source/id-ID/O005-BRIDGE-C[1234]/notebooks/requirements\\.lock$"
        },
        "requirements_lock_sha256": {"$ref": "#/$defs/sha256"},
        "toolchain": {"$ref": "#/$defs/toolchain"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C1"}}},
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "authority_manifest": {"const": "authority/units/O005-BRIDGE-C1/AUTHORITY_MANIFEST.json"}
            }
          },
          "target": {
            "properties": {
              "content_path": {"const": "source/id-ID/O005-BRIDGE-C1/content.html"}
            }
          },
          "segments": {
            "properties": {
              "path": {"const": "backend/segments/O005-BRIDGE-C1.segments.jsonl"},
              "id_strategy": {"const": "versioned-semantic-ledger-v1"},
              "id_ledger_path": {
                "pattern": "^backend/segment-ids/O005-BRIDGE-C1\\.segment-ids\\.v[1-9][0-9]*\\.json$"
              }
            }
          },
          "problems": {"items": {"pattern": "^O005-BRIDGE-C1-P0[1-7]$"}},
          "mastery_path": {"const": "backend/mastery/O005-BRIDGE-C1.mastery.json"},
          "notebook_path": {
            "const": "source/id-ID/O005-BRIDGE-C1/notebooks/bridge-c1-reproducible-workflow.ipynb"
          },
          "build": {
            "properties": {
              "generator": {"const": "scripts/generate_bridge_c1.py"},
              "requirements_lock": {
                "const": "source/id-ID/O005-BRIDGE-C1/notebooks/requirements.lock"
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C2"}}},
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "authority_manifest": {"const": "authority/units/O005-BRIDGE-C2/AUTHORITY_MANIFEST.json"}
            }
          },
          "target": {
            "properties": {
              "content_path": {"const": "source/id-ID/O005-BRIDGE-C2/content.html"}
            }
          },
          "segments": {
            "properties": {
              "path": {"const": "backend/segments/O005-BRIDGE-C2.segments.jsonl"},
              "id_strategy": {"const": "html-anchored-versioned-semantic-ledger-v1"},
              "id_ledger_path": {
                "pattern": "^backend/segment-ids/O005-BRIDGE-C2\\.segment-ids\\.v[1-9][0-9]*\\.json$"
              }
            }
          },
          "problems": {"items": {"pattern": "^O005-BRIDGE-C2-P0[1-7]$"}},
          "mastery_path": {"const": "backend/mastery/O005-BRIDGE-C2.mastery.json"},
          "notebook_path": {
            "const": "source/id-ID/O005-BRIDGE-C2/notebooks/bridge-c2-local-bifurcations.ipynb"
          },
          "build": {
            "properties": {
              "generator": {"const": "scripts/generate_bridge_c2.py"},
              "requirements_lock": {
                "const": "source/id-ID/O005-BRIDGE-C2/notebooks/requirements.lock"
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C3"}}},
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "authority_manifest": {"const": "authority/units/O005-BRIDGE-C3/AUTHORITY_MANIFEST.json"}
            }
          },
          "target": {
            "properties": {
              "content_path": {"const": "source/id-ID/O005-BRIDGE-C3/content.html"}
            }
          },
          "segments": {
            "properties": {
              "path": {"const": "backend/segments/O005-BRIDGE-C3.segments.jsonl"},
              "id_strategy": {"const": "html-anchored-versioned-semantic-ledger-v1"},
              "id_ledger_path": {
                "pattern": "^backend/segment-ids/O005-BRIDGE-C3\\.segment-ids\\.v[1-9][0-9]*\\.json$"
              }
            }
          },
          "problems": {"items": {"pattern": "^O005-BRIDGE-C3-P0[1-7]$"}},
          "mastery_path": {"const": "backend/mastery/O005-BRIDGE-C3.mastery.json"},
          "notebook_path": {
            "const": "source/id-ID/O005-BRIDGE-C3/notebooks/bridge-c3-chaos-and-return-maps.ipynb"
          },
          "build": {
            "properties": {
              "generator": {"const": "scripts/generate_bridge_c3.py"},
              "requirements_lock": {
                "const": "source/id-ID/O005-BRIDGE-C3/notebooks/requirements.lock"
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C4"}}},
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "authority_manifest": {"const": "authority/units/O005-BRIDGE-C4/AUTHORITY_MANIFEST.json"}
            }
          },
          "target": {
            "properties": {
              "content_path": {"const": "source/id-ID/O005-BRIDGE-C4/content.html"}
            }
          },
          "segments": {
            "properties": {
              "path": {"const": "backend/segments/O005-BRIDGE-C4.segments.jsonl"},
              "id_strategy": {"const": "html-anchored-versioned-semantic-ledger-v1"},
              "id_ledger_path": {
                "pattern": "^backend/segment-ids/O005-BRIDGE-C4\\.segment-ids\\.v[1-9][0-9]*\\.json$"
              }
            }
          },
          "problems": {"items": {"pattern": "^O005-BRIDGE-C4-P0[1-7]$"}},
          "mastery_path": {"const": "backend/mastery/O005-BRIDGE-C4.mastery.json"},
          "notebook_path": {
            "const": "source/id-ID/O005-BRIDGE-C4/notebooks/bridge-c4-calibration-validation-uncertainty.ipynb"
          },
          "build": {
            "properties": {
              "generator": {"const": "scripts/generate_bridge_c4.py"},
              "requirements_lock": {
                "const": "source/id-ID/O005-BRIDGE-C4/notebooks/requirements.lock"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "pandoc", "python", "platform", "dependencies"],
      "properties": {
        "files": {
          "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
          "items": {"$ref": "#/$defs/fileIdentity"}
        },
        "pandoc": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "bytes", "sha256"],
          "properties": {
            "version": {"type": "string", "pattern": "^pandoc [0-9]+(?:\\.[0-9]+)+$"},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "python": {
          "type": "object", "additionalProperties": false,
          "required": ["implementation", "version", "executable_bytes", "executable_sha256"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "executable_bytes": {"type": "integer", "minimum": 1},
            "executable_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "platform": {
          "type": "object", "additionalProperties": false,
          "required": ["system", "release", "version", "machine"],
          "properties": {
            "system": {"type": "string", "minLength": 1},
            "release": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "machine": {"type": "string", "minLength": 1}
          }
        },
        "dependencies": {
          "type": "object", "additionalProperties": false,
          "required": ["beautifulsoup4", "jsonschema"],
          "properties": {
            "beautifulsoup4": {"type": "string", "minLength": 1},
            "jsonschema": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
