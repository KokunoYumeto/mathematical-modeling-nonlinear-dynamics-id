{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/o005-segment-id-ledger.schema.json",
  "title": "O005 durable semantic segment-ID ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "unit_id", "ledger_version", "content_path", "content_sha256",
    "strategy", "binding_algorithm", "next_serial", "previous", "entries"
  ],
  "properties": {
    "schema": {"const": "o005-segment-id-ledger-v2"},
    "unit_id": {"const": "O005-BRIDGE-C1"},
    "ledger_version": {"type": "integer", "minimum": 1},
    "content_path": {"const": "source/id-ID/O005-BRIDGE-C1/content.html"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "strategy": {"const": "explicit-versioned-semantic-key-v1"},
    "binding_algorithm": {"const": "sha256-html-path-nul-canonical-text-v1"},
    "next_serial": {"type": "integer", "minimum": 1},
    "previous": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/fileIdentity"}
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/activeEntry"},
          {"$ref": "#/$defs/retiredEntry"}
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^backend/segment-ids/O005-BRIDGE-C1\\.segment-ids\\.v[1-9][0-9]*\\.json$"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "activeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_key", "segment_id", "state", "slot_binding_sha256"],
      "properties": {
        "segment_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
        },
        "segment_id": {"type": "string", "pattern": "^O005-BRIDGE-C1-S[0-9]{4}$"},
        "state": {"const": "active"},
        "slot_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "retiredEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_key", "segment_id", "state", "retired_reason"],
      "properties": {
        "segment_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
        },
        "segment_id": {"type": "string", "pattern": "^O005-BRIDGE-C1-S[0-9]{4}$"},
        "state": {"const": "retired"},
        "retired_reason": {"type": "string", "minLength": 1},
        "replaced_by": {"type": "string", "pattern": "^O005-BRIDGE-C1-S[0-9]{4}$"}
      }
    }
  }
}
