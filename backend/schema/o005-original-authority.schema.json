{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/o005-original-authority.schema.json",
  "title": "O005 original bridge authority record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "unit_id", "canonical_language", "content_mode", "title",
    "created_date", "license", "model_identification", "relationship_to_spine",
    "files", "toolchain"
  ],
  "properties": {
    "schema": {"const": "o005-original-authority-v1"},
    "unit_id": {"type": "string", "pattern": "^O005-BRIDGE-C[1234]$"},
    "canonical_language": {"const": "id-ID"},
    "content_mode": {"const": "new_original_addition"},
    "title": {"type": "string", "minLength": 1},
    "created_date": {"enum": ["2026-08-22", "2026-08-23"]},
    "license": {"const": "CC BY-NC-SA 4.0"},
    "model_identification": {"const": "OpenAI Codex gpt-5.6-sol, Ultra."},
    "relationship_to_spine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spine", "relationship", "part_of_source_book", "endorsement_claimed"],
      "properties": {
        "spine": {"const": "Joceline Lega, Introduction to Mathematical Modeling, v1.01"},
        "relationship": {"const": "independent_supplement"},
        "part_of_source_book": {"const": false},
        "endorsement_claimed": {"const": false}
      }
    },
    "files": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileIdentity"}
    },
    "toolchain": {"$ref": "#/$defs/toolchain"}
  },
  "allOf": [
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C1"}}},
      "then": {"properties": {"created_date": {"const": "2026-08-22"}}}
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C2"}}},
      "then": {"properties": {"created_date": {"const": "2026-08-23"}}}
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C3"}}},
      "then": {"properties": {"created_date": {"const": "2026-08-23"}}}
    },
    {
      "if": {"properties": {"unit_id": {"const": "O005-BRIDGE-C4"}}},
      "then": {"properties": {"created_date": {"const": "2026-08-23"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "pandoc", "python", "platform", "dependencies"],
      "properties": {
        "files": {
          "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
          "items": {"$ref": "#/$defs/fileIdentity"}
        },
        "pandoc": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "bytes", "sha256"],
          "properties": {
            "version": {"type": "string", "pattern": "^pandoc [0-9]+(?:\\.[0-9]+)+$"},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "python": {
          "type": "object", "additionalProperties": false,
          "required": ["implementation", "version", "executable_bytes", "executable_sha256"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "executable_bytes": {"type": "integer", "minimum": 1},
            "executable_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "platform": {
          "type": "object", "additionalProperties": false,
          "required": ["system", "release", "version", "machine"],
          "properties": {
            "system": {"type": "string", "minLength": 1},
            "release": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "machine": {"type": "string", "minLength": 1}
          }
        },
        "dependencies": {
          "type": "object", "additionalProperties": false,
          "required": ["beautifulsoup4", "jsonschema"],
          "properties": {
            "beautifulsoup4": {"type": "string", "minLength": 1},
            "jsonschema": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
